# Use the target Supabase URL and publishable key. For local development, run
# `pnpm db:start` and copy the public values shown by `pnpm db:status`.
# Never place a secret/service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Self-service sign-up stays hidden unless explicitly enabled.
PTA_AUTH_SIGN_UP_ENABLED=false
